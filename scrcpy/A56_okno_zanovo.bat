@echo off
rem Пересоздать окно телефона: scrcpy строит окно по размеру кадра только при старте,
rem а на поворот устройства не реагирует, и смена плотности вовсе его закрывает.
rem Запускаем scrcpy НАПРЯМУЮ, а не через планировщик: скрипт и так выполняется в сеансе
rem пользователя (его вызывает AutoHotkey), графический контекст здесь есть.
taskkill /f /im scrcpy.exe >nul 2>&1
timeout /t 1 /nobreak >nul
start "" /min "%~dp0A56.bat"
